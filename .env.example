# --- Postgres (single source of truth: used by BOTH the db container and the app) ---
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=school

# --- Networking ---
DB_HOST=db              # service name on the compose network (how the app reaches the db)
DB_HOST_PORT=5432       # host port mapped to Postgres — change if 5432 is already taken
APP_HOST_PORT=8080      # host port mapped to the app