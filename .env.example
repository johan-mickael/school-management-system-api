# --- Postgres (single source of truth: used by BOTH the db container and the app) ---
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=school

# --- Networking ---
DB_HOST=db              # service name on the compose network (how the app reaches the db)
DB_HOST_PORT=5432       # host port mapped to Postgres — change if 5432 is already taken
APP_HOST_PORT=8080      # host port mapped to the app

CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Security (JWT) ---
JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes-long
JWT_TTL_SECONDS=3600

# --- Initial admin seeding (dev/local only; leave disabled elsewhere) ---
SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# --- Exam proctoring ---
EXAM_INTEGRITY_THRESHOLD=5